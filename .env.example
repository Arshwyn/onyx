# Copy to .env and fill in. Never commit .env or real values.

# --- App (required) ---
# Supabase project URL and public anon key (Project Settings -> API).
# Inlined into the bundle at build time; changing them requires a rebuild.
VITE_SUPABASE_URL=https://your-project-ref.supabase.example
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Docker (optional) ---
# Host port for docker compose. Defaults to 3010.
# PORT=3010
# Tag for the built image (onyx:<tag>). Defaults to latest.
# IMAGE_TAG=

# --- Claude Code MCP tooling (optional, dev only) ---
# Read by Claude Code from its own environment (shell or .claude/settings.local.json),
# not by Vite or the app. Needed only for the Supabase MCP server in .mcp.json.
SUPABASE_PROJECT_REF=your-project-ref
# SECRET: personal access token. Keep it out of version control.
SUPABASE_ACCESS_TOKEN=

# --- Manual testing (optional, dev only) ---
# Credentials of a test account, used when driving the app in a real browser.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
